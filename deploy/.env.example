# Copy to .env next to docker-compose.yml and fill in.

# The domain an A record points at this host. Caddy gets a certificate for it,
# and the app builds ETA share links from it.
DOMAIN=getmehome.example.com

# Let's Encrypt uses this for expiry warnings. A real address you read.
ACME_EMAIL=you@example.com

# Live buses and arrival predictions. Free key from https://developer.wmata.com/
# Without it the app still shows timetables, and says that is what it is doing.
WMATA_API_KEY=

# Geocoding. The default public Nominatim rate-limits hard and asks you not to
# lean on it — self-host or use a paid provider before this sees real traffic.
# GEOCODER_URL=https://nominatim.example.com
